// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id            Int            @id @default(autoincrement())
  title         String
  slug          String         @unique
  description   String
  content       String?
  icon          String?
  heroImage     String?
  caseImages    String?
  order         Int            @default(0)
  published     Boolean        @default(true)
  metaTitle     String?
  metaDesc      String?
  metaKeywords  String?
  ogImage       String?
  faqItems      String?
  galleryImages GalleryImage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model BeforeAfter {
  id          Int      @id @default(autoincrement())
  title       String
  treatment   String
  beforeImage String   // repurposed as the single combined image
  afterImage  String?  // kept for backward compat, no longer required
  description String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  reviewedAt  DateTime?
  metaTitle    String?
  metaDesc    String?
  metaKeywords String?
  ogImage     String?
  faqItems    String?
  internalLinks String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id        Int        @id @default(autoincrement())
  label     String
  href      String
  position  String     @default("left")   // "left" | "right"
  order     Int        @default(0)
  parentId  Int?
  parent    MenuItem?  @relation("SubMenuItems", fields: [parentId], references: [id], onDelete: Cascade)
  children  MenuItem[] @relation("SubMenuItems")
  enabled   Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model GalleryImage {
  id          Int      @id @default(autoincrement())
  title       String
  image       String
  description String?
  subcategory String?
  serviceId   Int
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServicePrice {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  price       String
  priceNote   String?
  category    String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MediaFolder {
  id        Int           @id @default(autoincrement())
  name      String
  parentId  Int?
  parent    MediaFolder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("SubFolders")
  files     MediaFile[]
  createdAt DateTime      @default(now())
}

model MediaFile {
  id        Int          @id @default(autoincrement())
  url       String       @unique
  name      String
  size      Int
  mimeType  String
  folderId  Int?
  folder    MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
}

// ── AI connector (MCP over OAuth 2.1, for ChatGPT and Claude) ───────────────
// Codes and tokens are stored as SHA-256 hashes. `secretFingerprint` ties each
// grant to the current ADMIN_SECRET, so rotating the password disconnects every
// assistant, the same way it logs out dashboard sessions. See src/lib/mcp/oauth.ts.
model McpClient {
  id           String        @id @default(cuid())
  name         String
  redirectUris String[]
  createdAt    DateTime      @default(now())
  codes        McpAuthCode[]
  tokens       McpToken[]
}

model McpAuthCode {
  id                String    @id @default(cuid())
  codeHash          String    @unique
  clientId          String
  client            McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  redirectUri       String
  codeChallenge     String
  resource          String
  scope             String
  familyId          String // tokens issued from this code; replaying the code revokes them
  secretFingerprint String
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())
}

model McpToken {
  id                String    @id @default(cuid())
  accessHash        String    @unique
  refreshHash       String    @unique
  familyId          String
  clientId          String
  client            McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  resource          String
  scope             String
  secretFingerprint String
  accessExpiresAt   DateTime
  refreshExpiresAt  DateTime
  rotatedAt         DateTime?
  revokedAt         DateTime?
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([familyId])
}

// Before/after snapshot of every change an AI assistant makes, so it can be undone.
model McpAuditLog {
  id         String   @id @default(cuid())
  tool       String
  entity     String // "post", "service", "price", ..., "settings", "media_file"
  entityId   String
  label      String
  before     Json?
  after      Json?
  clientName String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
